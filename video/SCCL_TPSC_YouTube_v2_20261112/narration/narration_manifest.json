    },
    {
      "id": "02_series",
      "text": "In normal operation, the reactor stays in series. The capacitor compensates its reactance.",
      "window": [
        14.5,
        20.8
      ],
      "start_s": 14.584125,
      "end_s": 20.715875,
      "duration_s": 6.13175,
