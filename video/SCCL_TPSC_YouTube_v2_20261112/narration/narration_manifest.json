  "segments": [
    {
      "id": "01_network",
      "text": "A short circuit can unleash enormous current! Here, two sources feed the fault. The limiter acts on source one. Source two connects directly to the downstream bus.",
      "window": [
        0.5,
        13.5
      ],
      "start_s": 1.1559999999999997,
