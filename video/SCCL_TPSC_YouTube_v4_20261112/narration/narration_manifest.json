    {
      "id": "02_series",
      "text": "This limiter keeps its reactor in series. In normal operation, the capacitor compensates the reactor's reactance.",
      "window": [
        0.4,
        8.4
      ],
      "start_s": 0.48544791666666687,
      "end_s": 8.314552083333334,
      "duration_s": 7.829104166666666,
      "tempo_factor": 1.0211464968152866,
      "source_sha256": "4e6823eef2cc1ee4e08a16c8a634dc2eab2a2e8df960c744998064fc583e433d"
    },
    {
      "id": "03_compensation",
      "text": "The thyristors are blocked. At sixty hertz, inductive and capacitive reactances nearly cancel, keeping the normal voltage drop small.",
      "window": [
        8.6,
        17.5
      ],
      "start_s": 8.685458333333333,
      "end_s": 17.414541666666665,
      "duration_s": 8.729083333333334,
      "tempo_factor": 1.0176,
      "source_sha256": "9c3565aca5ef716f06bf90169e4699d94d71b946681930aa21c0197b4b2c4256"
    },
    {
      "id": "04_fault",
      "text": "Now watch the fault response in slow motion. Initially, current flows through the capacitor.",
      "window": [
        18.5,
        25.4
      ],
      "start_s": 18.77,
      "end_s": 25.13,
      "duration_s": 6.36,
      "tempo_factor": 1.0,
      "source_sha256": "7c3b8bd7aab476851dae01ea47bf81a1dcb93e6fc8acb87c19902e5dd11d680b"
    },
    {
      "id": "05_delay",
      "text": "Detection takes zero point three seven milliseconds. Conduction starts after zero point four eight milliseconds.",
      "window": [
        25.8,
        33.0
      ],
      "start_s": 25.884854166666667,
      "end_s": 32.915145833333334,
      "duration_s": 7.030291666666667,
