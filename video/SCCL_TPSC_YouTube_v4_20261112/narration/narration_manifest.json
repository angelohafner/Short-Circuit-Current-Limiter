      "source_sha256": "f9fc3b34e00ee040787e8b811c9ff90a06f06450bbfa21f0ccaeea4bf82f5a9d"
    },
    {
      "id": "06_transfer",
      "text": "Current transfers to the bypass, removing capacitor compensation. The reactor now limits fault current in this branch. It was connected all along!",
      "window": [
        33.3,
        43.5
      ],
      "start_s": 33.385406249999996,
      "end_s": 43.414593749999995,
      "duration_s": 10.0291875,
