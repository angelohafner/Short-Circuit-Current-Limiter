    },
    {
      "id": "03_compensation",
      "text": "The thyristors are blocked. At sixty hertz, inductive and capacitive reactances nearly cancel, keeping the normal voltage drop small.",
      "window": [
        8.6,
        17.5
      ],
      "start_s": 8.685458333333333,
      "end_s": 17.414541666666665,
