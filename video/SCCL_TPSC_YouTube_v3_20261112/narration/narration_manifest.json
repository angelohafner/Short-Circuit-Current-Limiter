  "segments": [
    {
      "id": "02_series",
      "text": "This limiter keeps its reactor in series. In normal operation, the capacitor compensates the reactor's reactance.",
      "window": [
        0.4,
        8.4
      ],
      "start_s": 0.48544791666666687,
      "end_s": 8.314552083333334,
