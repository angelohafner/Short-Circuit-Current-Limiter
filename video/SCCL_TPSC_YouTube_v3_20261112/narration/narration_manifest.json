      "tempo_factor": 1.0176,
      "source_sha256": "9c3565aca5ef716f06bf90169e4699d94d71b946681930aa21c0197b4b2c4256"
    },
    {
      "id": "04_fault",
      "text": "Now watch the fault response in slow motion. Initially, current flows through the capacitor.",
      "window": [
        18.5,
        25.4
