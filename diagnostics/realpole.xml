      <script>
        <segment name="Fortran" id="1128091972" classid="CoreSegment">#STORAGE INTEGER:$(NINTEGER) REAL:$(NREAL)
#FUNCTION REAL REALPOLE Real Pole
!  $COM
#IF Dim==1
 #IF RESET==1
      $O = REALPOLE($R,
 #ELSEIF RESET==2
      $O = REALPOLE(E_BtoI(TIMEZERO),
 #ELSE
      $O = REALPOLE(0,
 #ENDIF
     +1,$LIMIT,$G,$T,$I,
 #IF RESET!=0
     +$YO,
 #ELSE
     +0.0,
 #ENDIF
 #IF Limit==1
     +$Min,$Max)
 #ELSE
     +-1.0E20,1.0E20)
 #ENDIF
#ELSEIF  Dim&gt;1
 #LOCAL INTEGER IVD1_1      
      DO IVD1_1=1,$Dim
 #IF RESET==1
        $O(IVD1_1) = REALPOLE($R,
 #ELSEIF RESET==2
        $O(IVD1_1) = REALPOLE(E_BtoI(TIMEZERO),
 #ELSE
        $O(IVD1_1) = REALPOLE(0,
 #ENDIF
     +1,$LIMIT,$G,$T,$I(IVD1_1),
 #IF RESET!=0
     +$YO,
 #ELSE
     +0.0,
 #ENDIF
 #IF Limit==1
     +$Min,$Max)
 #ELSE
     +-1.0E20,1.0E20)
 #ENDIF
      ENDDO
#ENDIF</segment>
        <segment name="Computations" id="1455775285" classid="CoreSegment">INTEGER NREAL = 5*Dim
INTEGER NINTEGER = 2*Dim</segment>
        <segment name="FlyBy" id="1908654690" classid="CoreSegment">Real Pole
:I
Input
:O
Output
:R
Reset - Non-zero value will reset the output</segment>
        <segment classid="CoreSegment" id="1288545023" name="C">#INCLUDE $(HomeDir)\CCoder\stdinc.pds
#STASH STRUCT $RealpolData data
#BEGIN
#IF
$data.use_init_output = 0;
#ENDIF
$data.enable_block = (int)1;
$data.enable_limits = (int)$LIMIT;
$data.gain = ($REAL)$G;
$data.time = ($REAL)$T;
#IF RESET!=0
$data.init_output = ($REAL)$YO;
#ELSE
$data.init_output = $Zero;
#ENDIF
#IF Limit==1
$data.lower_limit = ($REAL)$Min;
$data.upper_limit = ($REAL)$Max;
#ELSE
$data.lower_limit = -1.0E20;
$data.upper_limit = 1.0E20;
#ENDIF
#ENDBEGIN
#IF RESET==1
$data.use_init_output = $R;
#ELSEIF RESET==2
$data.use_init_output = (int)FIRSTSTEP;
#ENDIF
#IF Dim==1
$data.input = $I;
$O = $pscadlib_realpol(&amp;($data));
#ELSEIF Dim&gt;1
#LOCAL INTEGER IVD1_1
for ($IVD1_1 = 0; $IVD1_1 &lt; $Dim; $IVD1_1++) {
	$data.input = $I[$IVD1_1];
	$O[$IVD1_1] = $pscadlib_realpol(&amp;($data));
}
#ENDIF</segment>
      </script>
