      <script>
        <segment name="Branch" id="1464933943" classid="CoreSegment">  NBR = $DP   $DN   BREAKER  $ROFF
#IF SNUB==1
  SNBR = $DP $DN  1.0 0.1 1.0
#ENDIF
</segment>
        <segment name="Dsdyn" id="839740734" classid="CoreSegment">#STORAGE STOR:25 INTEGER:8 REAL:7 LOGICAL:2 RTCL:1 RTCI:1 RTCF:6
#BEGIN
      CALL PESWITCH1_CFG($TYPE2, $PFB,$RON, $ROFF,
     + $EBO, $Erw, $EFVD, $TEXT)
 #IF SNUB==1
      CALL E_BRANCH_CFG($SNBR,$SS,1,0,1,$RD,0.0,$CD)
 #ENDIF
#ENDBEGIN
! Power Electronic Switch Model: ~
#CASE Type {~Diode} {~Thyristor} {~GTO} {~IGBT} {~Transistor}
      CALL COMPONENT_ID(ICALL_NO,$#Component)
      CALL PESWITCH1_EXE($SS,$NBR,
#IF Type==0
     + 1, 0.0)
#ELSE
 #IF Intr==0 
     + $APUL, 0.0)
 #ELSE
     + NINT($IPUL(1)), $IPUL(2))
 #ENDIF
#ENDIF
#OUTPUT REAL Ton   {STOR(NEXC-15)}
#OUTPUT REAL Toff  {STOR(NEXC-14)}
#OUTPUT REAL Alpha {STOR(NEXC)}
#OUTPUT REAL Gamma {STOR(NEXC-2)}</segment>
        <segment name="Dsout" id="1386257460" classid="CoreSegment">#FUNCTION REAL VBRANCH Voltage across the branch
#OUTPUT REAL I     {$CBR:NBR}
#OUTPUT REAL V     {VBRANCH($SS,$NBR)}
#IF SNUB==1
#OUTPUT REAL It    {$CBR:NBR + $CBR:SNBR}
#ELSE
#OUTPUT REAL It    {$CBR:NBR} 
#ENDIF
</segment>
        <segment name="Computations" id="1127459782" classid="CoreSegment">#IF Type &lt; 3
INTEGER Type2 = Type
#ELSE
INTEGER Type2 = 3
#ENDIF</segment>
        <segment classid="CoreSegment" id="9888482" name="FlyBy">Power Electronic Device</segment>
      </script>
