      <script>
        <segment name="Fortran" id="1319393771" classid="CoreSegment">#BEGIN
      RTCF(NRTCF) = $Yo
      NRTCF = NRTCF + 1
#ENDBEGIN
#STORAGE RTCF:1
#FUNCTION REAL EMTDC_XINT 'Integrator /w Interpolation'
#LOCAL REAL RVD1_1
      RVD1_1 = RTCF(NRTCF) ! Initial Output
      NRTCF = NRTCF + 1
#IF (Mthd==0)&amp;&amp;(Dim==1) || ((Mthd==1)&amp;&amp;(INTR==0))
 #LOCAL REAL RVD2_1 2
      RVD2_1(1) = $I
      RVD2_1(2) = 0.0
#ENDIF
#IF (Reset==0) || ((Reset==1)&amp;&amp;(INTCLR==0))
 #LOCAL REAL RVD2_2 2
 #IF Reset==0
      RVD2_2(1) = 0.0
 #ELSE
      RVD2_2(1) = FLOAT($R)
 #ENDIF
      RVD2_2(2) = 0.0
#ENDIF
#IF (Mthd==0)&amp;&amp;(Dim&gt;1)
 #LOCAL INTEGER IVD1_1
 #LOCAL REAL RVD2_1 2
      DO IVD1_1 = 1,$Dim 
 #STORAGE REAL:${3*Dim}
        RVD2_1(1) = $I(IVD1_1)
        $O(IVD1_1) = EMTDC_XINT(0, 0, 0, RVD1_1, $T, 0.0, ~
 #CASE Extrn {~$YLo, $YHi,} {~$LmtLo, $LmtHi,}
 #IF Reset*INTCLR==0
     + RVD2_2, RVD2_1)
 #ELSE
     + $R, RVD2_1)
 #ENDIF
      ENDDO
#ELSE
 #STORAGE REAL:3
      $O = EMTDC_XINT(~
 #CASE Mthd {~0~}{~$INTR~}
~, $INTCLR, $Reset, RVD1_1, $T, ~
 #CASE Reset {~0.0, ~} {~$YRst, ~}
 #CASE Extrn {~$YLo, $YHi, ~} {~$LmtLo, $LmtHi, ~}
 #CASE Reset*INTCLR {~RVD2_2, } {~$R, }
 #IF (Mthd==0) || ((Mthd==1)&amp;&amp;(INTR==0))
     +RVD2_1)
 #ELSE
     +$I)
 #ENDIF
#ENDIF</segment>
        <segment name="FlyBy" id="96423867" classid="CoreSegment">Resettable Integrator with nonwindup limits

:I
Input
:R
Re-set (Non-zero integer input will
reset the output of the integrator
to the value specified)
:LmtHi
Upper Limit
:LmtLo
Lower Limit
:O
Output</segment>
        <segment classid="CoreSegment" id="399088258" name="C">#INCLUDE $(HomeDir)\CCoder\stdinc.pds
#STASH STRUCT $XIntData data
#BEGIN
    $data.output_0 = $Yo;
#ENDBEGIN
#IF Mthd==1 &amp;&amp; INTR!=0
#WARNING Interpolation on input is turned on for this modulator. Interpolation is not supported for external programs.
#ENDIF
#IF INTCLR!=0
#WARNING Interpolation on reset is turned on for this modulator. Interpolation is not supported for external programs.
#ENDIF
$data.reset_enab = $Reset;
$data.time = $T;
$data.output_init = ~
#CASE Reset {~0.0;} {~$YRst;}
$data.lower = ~
#CASE Extrn {~$YLo;} {~$LmtLo;}
$data.upper = ~
#CASE Extrn {~$YHi;} {~$LmtHi;}
$data.reset = ~
#IF Reset == 0 {~0.0;}{~$R;}
$data.input = $I;
$O = $pscadlib_xint(&amp;$data);</segment>
      </script>
