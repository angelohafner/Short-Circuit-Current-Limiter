      <script>
        <segment name="Fortran" id="1758997025" classid="CoreSegment">#STORAGE INTEGER:3
!  Flip Flop
#IF Type==0
      CALL EMTDC_FF($A,$B,$Type,1,2)
#ELSEIF Type==1
      CALL EMTDC_FF($A,$B,$Type,$Clk,$Edge)
#ELSE
      CALL EMTDC_FF($A,$A,$Type,$Clk,$Edge)
#ENDIF
#IF Set==0
#IF Clear==1
      IF ($PC .EQ. 0) STORI(NSTORI-3) = 0
#ELSEIF Clear==2
      IF ($PC .EQ. 1) STORI(NSTORI-3) = 0
#ENDIF
#ELSEIF Set==1
#IF Clear==0
      IF ($PS .EQ. 0) STORI(NSTORI-3) = 1
#ELSEIF Clear==1
      IF ($PS .EQ. 0 .AND. $PC .EQ. 1) STORI(NSTORI-3) = 1
      IF ($PS .EQ. 1 .AND. $PC .EQ. 0) STORI(NSTORI-3) = 0
#ELSEIF Clear==2
      IF ($PS .EQ. 0 .AND. $PC .EQ. 0) STORI(NSTORI-3) = 1
      IF ($PS .EQ. 1 .AND. $PC .EQ. 1) STORI(NSTORI-3) = 0
#ENDIF
#ELSEIF Set==2
#IF Clear==0 
      IF ($PS .EQ. 1) STORI(NSTORI-3) = 1
#ELSEIF Clear==1
      IF ($PS .EQ. 1 .AND. $PC .EQ. 1) STORI(NSTORI-3) = 1
      IF ($PS .EQ. 0 .AND. $PC .EQ. 0) STORI(NSTORI-3) = 0
#ELSEIF Clear==2
      IF ($PS .EQ. 1 .AND. $PC .EQ. 0) STORI(NSTORI-3) = 1
      IF ($PS .EQ. 0 .AND. $PC .EQ. 1) STORI(NSTORI-3) = 0
#ENDIF
#ENDIF
#IF Outpt!=1 {      $Q = STORI(NSTORI-3)}
#IF Outpt!=0 {      $NQ = 1 - STORI(NSTORI-3)}
!
</segment>
      </script>
