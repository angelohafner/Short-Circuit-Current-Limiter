      <script>
        <segment name="Fortran" id="1203187279" classid="CoreSegment">#SUBROUTINE EMTDC_X2COMP 'Comparator with Interpolation'
#STORAGE REAL:$(Dim)
!
#IF Dim==1
 #IF INTR==0
  #LOCAL REAL RVD2_1 2
 #ENDIF
!
      CALL EMTDC_X2COMP($INTR,0,$X,$I,$OL,0.0,$OH,
 #IF INTR==0
     +RVD2_1)
  #IF Conv==0
      $O = RVD2_1(1)
  #ELSE
      $O = NINT(RVD2_1(1))
  #ENDIF
 #ELSE
     +$O)
 #ENDIF
#ELSEIF Dim&gt;1
 #LOCAL INTEGER IVD1_1
 #LOCAL INTEGER IVD1_2
 #LOCAL REAL RVD2_1 2
      DO IVD1_1 = 1,$Dim
        IVD1_2 = 2*IVD1_1
        CALL EMTDC_X2COMP($INTR,0,$X,$I(IVD1_1),$OL,0.0,$OH,RVD2_1)
 #IF INTR==0
  #IF Conv==0
        $O(IVD1_1) = RVD2_1(1)
  #ELSE
        $O(IVD1_1) = NINT(RVD2_1(1))
  #ENDIF
 #ELSE
        $O(IVD1_2-1)= RVD2_1(1)
        $O(IVD1_2)= RVD2_1(2)
 #ENDIF
      ENDDO
#ENDIF</segment>
        <segment name="Computations" id="14253948" classid="CoreSegment">INTEGER DIM2=2*DIM</segment>
        <segment name="FlyBy" id="740151970" classid="CoreSegment">Single input level comparator
:I
Input
:O
Output</segment>
        <segment classid="CoreSegment" id="421289497" name="C">#INCLUDE $(HomeDir)\CCoder\stdinc.pds
#STASH STRUCT $x2compData data
#STASH STRUCT $xzcdData0 xzcdData
#BEGIN
$data.pls = 0;
$data.in1 = ($REAL)$X;
$data.out1 = ($REAL)$OL;
$data.out2 =$Zero;
$data.out3 = ($REAL)$OH;
#ENDBEGIN
#IF $Dim==1
$data.in2 = $I;
#IF $INTR==0
#IF $Conv==0
$O = $pscadlib_x2comp(&amp;($data), &amp;($xzcdData));
#ELSE
$O = ($INTEGER)$round($pscadlib_x2comp(&amp;($data), &amp;($xzcdData)));
#ENDIF
#ELSE
#WARNING Interpolation on input is turned on for this modulator. Interpolation is not supported for external programs.
#ENDIF
#ELSEIF $Dim&gt;1
#LOCAL int IVD1_1
#LOCAL int IVD1_2
for ($IVD1_1 = 0; $IVD1_1 &lt; $Dim; $IVD1_1++) {
	$IVD1_2 = 2*$IVD1_1;
	$data.in2 = $I[$IVD1_1];
#IF $INTR==0
#IF $Conv==0
	$O[$IVD1_1] = $pscadlib_x2comp(&amp;($data), &amp;($xzcdData));
#ELSE
	$O[$IVD1_1] = ($INTEGER)$round($pscadlib_x2comp(&amp;($data), &amp;($xzcdData));
#ENDIF
#ELSE
#WARNING Interpolation on input is turned on for this modulator. Interpolation is not supported for external programs.#ENDIF
#ENDIF
}
#ENDIF
#ENDIF</segment>
      </script>
