        <segment name="Computations" id="930564289" classid="CoreSegment">#IF Cnfg==2
INTEGER Npnts1 = 2*Npnts + 4
INTEGER Npnts2 = 3*Npnts + 19
#ELSE
INTEGER Npnts1 = 24
INTEGER Npnts2 = 52
#ENDIF</segment>
        <segment name="Dsdyn" id="592168207" classid="CoreSegment">!  Metal Oxide Gapless Surge Arrester: $Name
#IF $#DIM(NT)==3 || $#DIM(NF)==3
  #STORAGE STOR:$(Npnts2) INTEGER:6 RTCI:3 RTCF:$(Npnts1)
  #STORAGE RTCF:$(Npnts1) STOR:$(Npnts2)
  #STORAGE RTCF:$(Npnts1) STOR:$(Npnts2)
#ELSEIF $#DIM(NT)==2 || $#DIM(NF)==2
  #STORAGE STOR:$(Npnts2) INTEGER:4 RTCI:2 RTCF:$(Npnts1)
  #STORAGE RTCF:$(Npnts1) STOR:$(Npnts2)
#ELSEIF $#DIM(NT)==1 &amp;&amp; $#DIM(NF)==1
  #STORAGE STOR:$(Npnts2) INTEGER:2 RTCI:1 RTCF:$(Npnts1)
#ENDIF
#BEGIN
 #LOCAL REAL RVD100_1 100
 #LOCAL REAL RVD100_2 100
      CALL COMPONENT_ID(ICALL_NO,$#Component)
      RVD100_1 = 0.0
      RVD100_2 = 0.0
 #IF Cnfg!=2
      RVD100_1(1)  = ~
  #CASE Cnfg {~0.001}{~$X1}
      RVD100_2(1)  = ~
  #CASE Cnfg {~1.1}{~$Y1}
      RVD100_1(2)  = ~
  #CASE Cnfg {~0.01}{~$X2}
      RVD100_2(2)  = ~
  #CASE Cnfg {~1.6}{~$Y2}
      RVD100_1(3)  = ~
  #CASE Cnfg {~0.1}{~$X3}
      RVD100_2(3)  = ~
  #CASE Cnfg {~1.7}{~$Y3}
      RVD100_1(4)  = ~
  #CASE Cnfg {~0.2}{~$X4}
      RVD100_2(4)  = ~
  #CASE Cnfg {~1.739}{~$Y4}
      RVD100_1(5)  = ~
  #CASE Cnfg {~0.38}{~$X5}
      RVD100_2(5)  = ~
  #CASE Cnfg {~1.777}{~$Y5}
      RVD100_1(6)  = ~
  #CASE Cnfg {~0.65}{~$X6}
      RVD100_2(6)  = ~
  #CASE Cnfg {~1.815}{~$Y6}
      RVD100_1(7)  = ~
  #CASE Cnfg {~1.11}{~$X7}
      RVD100_2(7)  = ~
  #CASE Cnfg {~1.853}{~$Y7}
      RVD100_1(8)  = ~
  #CASE Cnfg {~1.5}{~$X8}
      RVD100_2(8)  = ~
  #CASE Cnfg {~1.881}{~$Y8}
      RVD100_1(9)  = ~
  #CASE Cnfg {~2.0}{~$X9}
      RVD100_2(9)  = ~
  #CASE Cnfg {~1.91}{~$Y9}
      RVD100_1(10) = ~
  #CASE Cnfg {~2.8}{~$X10}
      RVD100_2(10) = ~
  #CASE Cnfg {~1.948}{~$Y10}
      RVD100_1(11) = ~
  #CASE Cnfg {~200.0}{~$X11}
      RVD100_2(11) = ~
  #CASE Cnfg {~3.2}{~$Y11}
 #ENDIF
 #IF $#DIM(NT)==3 || $#DIM(NF)==3
      CALL ARRESTERZNO_CFG($SS,$NBR(1),$Cnfg,$VSCAL,$ISCAL,RVD100_1,RVD100_2,~
  #CASE path {~"../$File")}{~"$File")}
      CALL ARRESTERZNO_CFG($SS,$NBR(2),$Cnfg,$VSCAL,$ISCAL,RVD100_1,RVD100_2,~
  #CASE path {~"../$File")}{~"$File")}
      CALL ARRESTERZNO_CFG($SS,$NBR(3),$Cnfg,$VSCAL,$ISCAL,RVD100_1,RVD100_2,~
  #CASE path {~"../$File")}{~"$File")}
 #ELSEIF $#DIM(NT)==2 || $#DIM(NF)==2
      CALL ARRESTERZNO_CFG($SS,$NBR(1),$Cnfg,$VSCAL,$ISCAL,RVD100_1,RVD100_2,~
  #CASE path {~"../$File")}{~"$File")}
      CALL ARRESTERZNO_CFG($SS,$NBR(2),$Cnfg,$VSCAL,$ISCAL,RVD100_1,RVD100_2,~
  #CASE path {~"../$File")}{~"$File")}
 #ELSEIF $#DIM(NT)==1 &amp;&amp; $#DIM(NF)==1
      CALL ARRESTERZNO_CFG($SS,$NBR,$Cnfg,$VSCAL,$ISCAL,RVD100_1,RVD100_2,~
  #CASE path {~"../$File")}{~"$File")}
 #ENDIF
#ENDBEGIN
      CALL COMPONENT_ID(ICALL_NO,$#Component)
#IF $#DIM(NT)==3 || $#DIM(NF)==3
      CALL ARRESTERZNO_EXE($SS,$NBR(1),$ENAB)
      CALL ARRESTERZNO_EXE($SS,$NBR(2),$ENAB)
      CALL ARRESTERZNO_EXE($SS,$NBR(3),$ENAB)
#ELSEIF $#DIM(NT)==2 || $#DIM(NF)==2
      CALL ARRESTERZNO_EXE($SS,$NBR(1),$ENAB)
      CALL ARRESTERZNO_EXE($SS,$NBR(2),$ENAB)
#ELSEIF $#DIM(NT)==1 &amp;&amp; $#DIM(NF)==1
      CALL ARRESTERZNO_EXE($SS,$NBR,$ENAB)
#ENDIF</segment>
        <segment name="Dsout" id="1303373627" classid="CoreSegment">#FUNCTION REAL E_VZNO50 Access calculated energy of arrester
#IF $#DIM(NT)==3 || $#DIM(NF)==3
