#ELSEIF $#DIM(NT)==2 || $#DIM(NF)==2
#OUTPUT REAL Curr 2 {-$CBR:NBR(1)} {-$CBR:NBR(2)}
#OUTPUT REAL Energy 2 {E_VZNO50($SS,$NBR(1))} {E_VZNO50($SS,$NBR(2))}
#ELSEIF $#DIM(NT)==1 &amp;&amp; $#DIM(NF)==1
#OUTPUT REAL Curr   {-$CBR:NBR}
#OUTPUT REAL Energy {E_VZNO50($SS,$NBR)}
#ENDIF
!</segment>
